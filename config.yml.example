global_settings:
  proxy_port: 8888          # request clients point here
  proxy_publish: true       # set false to use only proxy_client_network_name without host publishing
  proxy_bind: 127.0.0.1     # proxy host bind; non-loopback requires allow_public_proxy + CIDR allowlist
  api_bind: 127.0.0.1       # controller API/dashboard host bind; use 0.0.0.0 only behind firewall/auth
  stats_port: 8404          # HAProxy stats UI at /stats
  stats_bind: 127.0.0.1     # stats host bind; non-loopback requires stats auth or CIDR allowlist
  proxy_client_network_name: "" # optional Docker network for client containers to reach HAProxy by alias
  proxy_client_network_external: false # true when the client network is created outside chamosel
  proxy_client_network_alias: chamosel-proxy # proxy DNS name inside proxy_client_network_name
  allow_public_proxy: false # set true only with proxy_allowed_cidrs and firewall/reverse-proxy controls
  proxy_allowed_cidrs: ""   # comma-separated source CIDRs allowed to use a non-loopback proxy bind
  stats_auth_user: ""       # optional HAProxy stats username when exposing stats
  stats_auth_password: ""   # optional HAProxy stats password; prefer setting from a local secret workflow
  stats_allowed_cidrs: ""   # comma-separated source CIDRs allowed to view stats
  api_port: 8800            # controller REST API + dashboard + /metrics
  # env_file: .env.local    # optional provider secrets file for generated gluetun services
  image: qmcgaw/gluetun:v3
  haproxy_image: haproxy:3.0-alpine
  balance: roundrobin       # or leastconn
  auto_rotate_seconds: 0    # 0 = off; e.g. 1800 rotates one instance every 30 min
  rotate_cooldown: 60       # min seconds between rotations of the same instance
  rotation_recovery_timeout: 30 # seconds to wait for VPN recovery + changed IP
  rotate_all_batch_size: 2  # max concurrent backends rotated by rotate/all
  rotate_all_batch_delay_seconds: 2 # delay between rotate/all batches
  pool_degraded_min_healthy: auto # auto = all configured backends should be healthy
  auto_repair_duplicate_ips: true # rotate one duplicate/proxy-failed backend after health refresh
  duplicate_repair_retry_cooldown: 300 # retry delay after failed duplicate-IP repair
  egress_verify_target: https://ifconfig.co/json # target used to verify actual proxy exit IP
  egress_verify_timeout: 10 # per-backend verified proxy IP timeout
  egress_verify_ttl: 120    # seconds to trust cached verified proxy IP
  egress_verify_on_fresh: true # /pool?fresh=1 refreshes verified proxy IP when expired
  dashboard_refresh_seconds: 5 # default dashboard auto-refresh interval; 0 disables
  # DNS upstream overrides for gluetun. Leave empty to keep gluetun defaults.
  # dns_upstream_resolver_type: "" # dot/doh/plain; auto plain when dns_upstream_plain_addresses is set
  # dns_upstream_resolvers: "" # named DoT/DoH resolvers, e.g. "cloudflare,quad9"
  # dns_upstream_plain_addresses: "" # provider DNS ip:port list, e.g. values from provider WireGuard config
  controller_auth_enabled: false # protect controller API/dashboard/metrics/repair with X-Chamosel-Auth
  # controller_auth_token: "" # optional fallback; prefer CONTROLLER_AUTH_TOKEN in .env.local
  poll_interval: 15         # background health/IP poll interval
  # api_key: ""             # optional; auto-generated into .env if omitted

vpn_providers:

  surfshark:
    num_containers: 4
    env:
      VPN_TYPE: wireguard
      WIREGUARD_PRIVATE_KEY: "[YOUR_WG_PRIVATE_KEY]"
      WIREGUARD_ADDRESSES: "10.14.0.2/16"
      SERVER_COUNTRIES: "Germany,Netherlands,France,Poland"

  # Mix providers freely:
  # protonvpn:
  #   num_containers: 2
  #   env:
  #     OPENVPN_USER: "[USERNAME]"
  #     OPENVPN_PASSWORD: "[PASSWORD]"
  #     SERVER_COUNTRIES: "Netherlands"
