# Generated by chamosel - do not edit by hand
services:
{% for inst in instances %}
  {{ inst.name }}:
    container_name: {{ inst.name }}
    image: {{ image }}
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun
    security_opt:
      - no-new-privileges:true
{% if env_file %}
    env_file:
      - {{ env_file | tojson }}
{% endif %}
    environment:
      HTTPPROXY: "on"
      HTTPPROXY_LISTENING_ADDRESS: ":8888"
      HEALTH_SERVER_ADDRESS: "0.0.0.0:{{ gluetun_health_port }}"
      # Control server + apikey auth (gluetun v3.40+ requires auth on all routes)
      HTTP_CONTROL_SERVER_ADDRESS: "0.0.0.0:{{ gluetun_control_port }}"
      HTTP_CONTROL_SERVER_AUTH_DEFAULT_ROLE: {{ auth_default_role | tojson }}
{% for k, v in inst.env.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
    volumes:
      - gluetun_{{ inst.name }}:/gluetun
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    restart: unless-stopped
    networks:
      - chamosel-net
{% endfor %}

  haproxy:
    container_name: chamosel-haproxy
    image: {{ haproxy_image }}
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    ports:
{% if proxy_publish == "true" %}
      - "{{ proxy_bind }}:{{ proxy_port }}:{{ proxy_port }}/tcp"
{% endif %}
      - "{{ stats_bind }}:{{ stats_port }}:{{ stats_port }}/tcp"
    restart: unless-stopped
    volumes:
      - ./haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
    networks:
      chamosel-net:
{% if proxy_client_network_name %}
      proxy-client-net:
        aliases:
          - {{ proxy_client_network_alias | tojson }}
{% endif %}

  controller:
    container_name: chamosel-ctrl
    build: ./controller
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    ports:
      - "{{ api_bind }}:{{ api_port }}:{{ controller_port }}/tcp"
    environment:
      INSTANCES: {{ names | join(',') | tojson }}
      GLUETUN_CONTROL_PORT: "{{ gluetun_control_port }}"
      GLUETUN_API_KEY: "${GLUETUN_API_KEY}"
      CONTROLLER_AUTH_ENABLED: "{{ controller_auth_enabled }}"
      CONTROLLER_AUTH_TOKEN: "${CONTROLLER_AUTH_TOKEN}"
      PYTHONDONTWRITEBYTECODE: "1"
      LISTEN_PORT: "{{ controller_port }}"
      AUTO_ROTATE_SECONDS: "{{ auto_rotate }}"
      ROTATE_COOLDOWN: "{{ rotate_cooldown }}"
      ROTATION_RECOVERY_TIMEOUT: "{{ rotation_recovery_timeout }}"
      ROTATE_ALL_BATCH_SIZE: "{{ rotate_all_batch_size }}"
      ROTATE_ALL_BATCH_DELAY_SECONDS: "{{ rotate_all_batch_delay_seconds }}"
      POOL_DEGRADED_MIN_HEALTHY: "{{ pool_degraded_min_healthy }}"
      AUTO_REPAIR_DUPLICATE_IPS: "{{ auto_repair_duplicate_ips }}"
      DUPLICATE_REPAIR_RETRY_COOLDOWN: "{{ duplicate_repair_retry_cooldown }}"
      EGRESS_VERIFY_TARGET: {{ egress_verify_target | tojson }}
      EGRESS_VERIFY_TIMEOUT: "{{ egress_verify_timeout }}"
      EGRESS_VERIFY_TTL: "{{ egress_verify_ttl }}"
      EGRESS_VERIFY_ON_FRESH: "{{ egress_verify_on_fresh }}"
      DASHBOARD_REFRESH_SECONDS: "{{ dashboard_refresh_seconds }}"
      DASHBOARD_STATS_URL: {{ dashboard_stats_url | tojson }}
      POLL_INTERVAL: "{{ poll_interval }}"
      STATE_FILE: "/data/state.json"
    volumes:
      - chamosel_state:/data
    restart: unless-stopped
    networks:
      - chamosel-net

volumes:
{% for n in names %}
  gluetun_{{ n }}:
{% endfor %}
  chamosel_state:

networks:
  chamosel-net:
{% if proxy_client_network_name %}
  proxy-client-net:
    name: {{ proxy_client_network_name | tojson }}
{% if proxy_client_network_external == "true" %}
    external: true
{% endif %}
{% endif %}
