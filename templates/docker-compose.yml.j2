# Generated by chamosel - do not edit by hand
services:
{% for inst in instances %}
  {{ inst.name }}:
    container_name: {{ inst.name }}
    image: {{ image }}
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun
    environment:
      - HTTPPROXY=on
      - HTTPPROXY_LISTENING_ADDRESS=:8888
      - HEALTH_SERVER_ADDRESS=0.0.0.0:{{ gluetun_health_port }}
      # Control server + apikey auth (gluetun v3.40+ requires auth on all routes)
      - HTTP_CONTROL_SERVER_ADDRESS=0.0.0.0:{{ gluetun_control_port }}
      - 'HTTP_CONTROL_SERVER_AUTH_DEFAULT_ROLE={{ auth_default_role }}'
{% for e in inst.env %}
      - {{ e }}
{% endfor %}
    volumes:
      - gluetun_{{ inst.name }}:/gluetun
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    restart: unless-stopped
    networks:
      - chamosel-net
{% endfor %}

  haproxy:
    container_name: chamosel-haproxy
    image: {{ haproxy_image }}
    ports:
      - "{{ proxy_port }}:{{ proxy_port }}/tcp"
      - "{{ stats_port }}:{{ stats_port }}/tcp"
    restart: unless-stopped
    volumes:
      - ./haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro
    networks:
      - chamosel-net

  controller:
    container_name: chamosel-ctrl
    build: ./controller
    ports:
      - "{{ api_port }}:{{ controller_port }}/tcp"
    environment:
      - INSTANCES={{ names | join(',') }}
      - GLUETUN_CONTROL_PORT={{ gluetun_control_port }}
      - GLUETUN_API_KEY=${GLUETUN_API_KEY}
      - LISTEN_PORT={{ controller_port }}
      - AUTO_ROTATE_SECONDS={{ auto_rotate }}
      - ROTATE_COOLDOWN={{ rotate_cooldown }}
      - POLL_INTERVAL={{ poll_interval }}
      - STATE_FILE=/data/state.json
    volumes:
      - chamosel_state:/data
    restart: unless-stopped
    networks:
      - chamosel-net

volumes:
{% for n in names %}
  gluetun_{{ n }}:
{% endfor %}
  chamosel_state:

networks:
  chamosel-net:
