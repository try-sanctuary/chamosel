# Generated by chamosel - do not edit by hand
global
    log stdout format raw local0
    maxconn 4096

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client  120s
    timeout server  120s
    retries 2
    option redispatch

frontend stats
    mode http
    bind 0.0.0.0:{{ stats_port }}
{% if stats_allowed_cidrs %}
    acl allowed_stats_src src {{ stats_allowed_cidrs | join(' ') }}
    http-request deny unless allowed_stats_src
{% endif %}
    stats enable
    stats uri /stats
    stats refresh 5s
{% if stats_auth_user and stats_auth_password %}
    stats auth {{ stats_auth_user }}:{{ stats_auth_password }}
{% endif %}

frontend proxy_in
    bind *:{{ proxy_port }}
{% if proxy_allowed_cidrs %}
    acl allowed_proxy_src src {{ proxy_allowed_cidrs | join(' ') }}
    tcp-request connection reject unless allowed_proxy_src
{% endif %}
    default_backend gluetun_pool

backend gluetun_pool
    balance {{ balance }}
    # Probe gluetun's health server, not the proxy port: a gluetun with a
    # dead VPN still accepts proxy connections (kill switch only blocks egress).
    option httpchk
    http-check connect port {{ gluetun_health_port }}
    http-check send meth GET uri /
    http-check expect status 200-399
{% for name in names %}
    server {{ name }} {{ name }}:{{ gluetun_proxy_port }} check inter 5s fall 2 rise 2
{% endfor %}
